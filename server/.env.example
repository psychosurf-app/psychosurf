# Copy to .env on the server and fill in. .env is never committed (R-34).
DATABASE_URL=postgres://psychosurf:CHANGE_ME@localhost:5432/psychosurf
# Token of @psychosurf_bot from BotFather. Yana gives it to Liza personally (Z-8), never in chats.
BOT_TOKEN=CHANGE_ME
# Where the app lives (CORS), comma-separated.
ALLOWED_ORIGINS=https://psychosurf-app.github.io
# pool.json from the private repo psychosurf-advice, copied next to the server.
POOL_PATH=/opt/psychosurf/pool.json
# 1 = closed test before the public launch: everything open (R-23).
TESTERS_FREE=1
PORT=3000
